rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    // Authenticated users can read/create/update their profile; admin can read all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAuthenticated();
      allow delete: if isOwner(userId);

      // Wishlist subcollection
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Products collection
    // Anyone (guests/customers) can view products; authenticated staff/admin can manage
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Orders collection
    // Customers can place orders and read their own; Admin and Delivery can view and update status
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 4. Notifications collection
    // Users can read/update their notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
